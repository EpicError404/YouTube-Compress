<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Uygulama Başlığı -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- YouTube Link Giriş Alanı -->
        <EditText
            android:id="@+id/etVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:inputType="textUri"
            android:layout_marginBottom="12dp" />

        <!-- Kalite Seçim Başlığı -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_quality"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Çözünürlük Radyo Grubu (144p - 720p) -->
        <RadioGroup
            android:id="@+id/rgQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rb144"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="144p" />

            <RadioButton
                android:id="@+id/rb240"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="240p" />

            <RadioButton
                android:id="@+id/rb360"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="360p" />

            <RadioButton
                android:id="@+id/rb480"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="480p" />

            <RadioButton
                android:id="@+id/rb720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/rb_720" />
        </RadioGroup>

        <!-- Sadece Wi-Fi İle İndir Toggle -->
        <Switch
            android:id="@+id/switchWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_only"
            android:layout_marginBottom="16dp" />

        <!-- Video + Ses İndir Butonu -->
        <Button
            android:id="@+id/btnDownloadVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_download_video"
            android:layout_marginBottom="8dp" />

        <!-- Sadece Ses İndir Butonu -->
        <Button
            android:id="@+id/btnDownloadAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_download_audio"
            android:layout_marginBottom="8dp" />

        <!-- İndirilen Dosyalarım / Klasör Butonu -->
        <Button
            android:id="@+id/btnOpenFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_folder"
            android:layout_marginBottom="8dp" />

        <!-- İndirme Durumu Metni -->
        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- İlerleme Çubuğu -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Dosyayı Aç Butonu -->
        <Button
            android:id="@+id/btnOpenFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_file"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Dil Değiştirme Butonu -->
        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_language"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>